# Server Environment Configuration
# Options: development | production | test
NODE_ENV=development

# Server Port
PORT=8080

# MongoDB Connection String (e.g., local MongoDB or MongoDB Atlas URI)
MONGO_URL=mongodb://localhost:27017/geekbase

# CORS Allowed Origin (comma-separated origins allowed in production or development)
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
# Must be at least 8 characters (32+ recommended for production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_characters
JWT_EXPIRES_IN=7d
